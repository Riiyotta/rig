    },
    {
      "id": "ORIGINAL_COPY_FINGERPRINT",
      "severity": "error",
      "description": "No copy string (or sentence of >= 5 words) may match a fingerprint of the ORIGINAL rig.ai site copy (assets/original-copy-fingerprints.json stores SHA-256 prefixes only - never the wording).",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
