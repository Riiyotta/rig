                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "ol"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxWords": 36,
                      "evidence": {
                        "longestObserved": "**Speculative decoding** with a tiny draft model, to cut the cost of predictable tokens such as closing brackets, repeated identifiers and boilerplate imports that the main model would otherwise generate one expensive step at a time.",
                        "citation": "src/blog.js:135"
                      }
                    },
                    "minItems": 1,
                    "maxItems": 5
