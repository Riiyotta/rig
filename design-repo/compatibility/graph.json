      ]
    },
    {
      "id": "SHADER_PRESET_BY_SECTION",
      "severity": "error",
      "description": "Shader canvases only in the three shader sections with their fixed preset (closed enum headline | how); at most 3 per page.",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
