      ]
    },
    {
      "id": "SOURCE_BRAND_IN_COPY",
      "severity": "warn",
      "description": "Copy naming the real company (Rig, rig.ai, Rig AI Inc.) is flagged. The clone's own placeholder copy uses the name, so this is a warning in this private design review; production generation must substitute the client's brand.",
