    {
      "id": "NO_ASSET_URLS",
      "severity": "error",
      "description": "Content strings never carry asset file paths/URLs (.png/.svg/.woff2, /assets/, /fonts/): media is referenced by assetRole only, so the real Rig wordmark/logo files cannot be smuggled in.",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
