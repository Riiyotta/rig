    {
      "id": "DOUBLE_DIVIDER_BEFORE_HOW",
      "severity": "error",
      "description": "how.stepper is immediately preceded by exactly two rule dividers (the real double divider), and that is the only place two rule dividers are adjacent. Keyed on (section, variant): the FAQ's rule + spacer-bottom pair is NOT a double divider.",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
        "src/pages/Home.jsx:39-42",
        "CLONE_SPEC.md:463"
