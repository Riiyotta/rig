                    "const": "h3"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxWords": 4,
                    "evidence": {
                      "longestObserved": "Choosing what to keep",
                      "citation": "src/blog.js:203"
                    }
                  }
                },
                "required": [
                  "kind",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
