    {
      "id": "NO_EXTERNAL_TARGETS",
      "severity": "error",
      "description": "No URL schemes, hosts, www., link/iframe/form markup, or inline [label](target) links whose target is not an internal route. Link objects use closed kinds (route | fragment | placeholder | share-intent).",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
        "src/components/Footer.jsx:7"
      ]
    },
    {
      "id": "NO_BACKEND_ENDPOINTS",
      "severity": "error",
      "description": "No generated page may reference a submission endpoint or the original's third-party services: forms are local-only (schema const). Wiring a real endpoint needs human review.",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
