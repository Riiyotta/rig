{
  "pageSpecVersion": "1.0.0",
  "id": "blog-post-not-found",
  "route": "/blog/this-post-does-not-exist",
  "template": "tpl.blog-post",
  "theme": "dark",
  "nodes": [
    {
      "type": "shell.overlays",
      "content": {
        "grainFilter": {
          "assetRole": "effect.svg-filter"
        }
      },
      "motion": {
        "pattern": "grain-overlay-smil",
        "reducedMotionFallback": "static-grain-frame"
      }
    },
    {
      "type": "shell.header",
      "variant": "default",
      "content": {
        "logo": {
          "assetRole": "brand.wordmark"
        },
        "links": [
          {
            "label": "Blog",
            "target": {
              "kind": "route",
              "route": "/blog"
            }
          }
        ],
        "cta": {
          "label": "Get Early Access",
          "target": {
            "kind": "route",
            "route": "/waitlist"
          }
        }
      },
      "motion": {
        "pattern": "mobile-menu-fade",
        "reducedMotionFallback": "instant-toggle"
      }
    },
    {
      "type": "post.article",
      "variant": "not-found",
      "content": {
        "title": "Post not found",
        "body": "There is no post at this address. It may have moved, or the link may be mistyped.",
        "backLabel": "All Posts",
        "backTarget": {
          "kind": "route",
          "route": "/blog"
        }
      },
      "motion": {
        "pattern": "none",
        "reducedMotionFallback": "none"
      }
    },
    {
      "type": "shell.footer",
      "content": {
        "logo": {
          "assetRole": "brand.wordmark"
        },
        "tagline": "On-device AI for engineers who’d rather not depend on the cloud.",
        "columns": [
          {
            "title": "Connect",
            "links": [
              {
                "label": "Twitter",
                "target": {
                  "kind": "placeholder"
                }
              },
              {
                "label": "LinkedIn",
                "target": {
                  "kind": "placeholder"
                }
              }
            ]
          },
          {
            "title": "Legal",
            "links": [
              {
                "label": "Terms of Service",
                "target": {
                  "kind": "route",
                  "route": "/terms"
                }
              },
              {
                "label": "Privacy Policy",
                "target": {
                  "kind": "route",
                  "route": "/privacy"
                }
              }
            ]
          }
        ],
        "copyright": "© 2026 Example Company. All rights reserved.",
        "status": "All systems local",
        "watermark": {
          "assetRole": "brand.logo-mark"
        }
      },
      "motion": {
        "pattern": "status-blink",
        "reducedMotionFallback": "steady-dot"
      }
    }
  ]
}
