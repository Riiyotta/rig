{
  "$description": "All breakpoints are max-width (desktop-first). xl/lg/tab/md are the site-wide set wired into tailwind.config.js screens; the rest are page-scoped rules that really exist in src/styles.",
  "breakpoint": {
    "xl": {
      "$type": "dimension",
      "$value": "1280px",
      "measuredFrom": "tailwind.config.js:10",
      "evidenceQuote": "1280px",
      "$description": "max-width 1280: containers go 90% wide, 0 side padding",
      "query": "(max-width: 1280px)"
    },
    "lg": {
      "$type": "dimension",
      "$value": "1024px",
      "measuredFrom": "tailwind.config.js:11",
      "evidenceQuote": "1024px",
      "$description": "max-width 1024: container padding 2rem; grids to 2 cols",
      "query": "(max-width: 1024px)"
    },
    "tab": {
      "$type": "dimension",
      "$value": "769px-1024px",
      "measuredFrom": "tailwind.config.js:12",
      "evidenceQuote": "769px",
      "$description": "tablet band",
      "query": "(max-width: 1024px) and (min-width: 769px)"
    },
    "md": {
      "$type": "dimension",
      "$value": "768px",
      "measuredFrom": "tailwind.config.js:13",
      "evidenceQuote": "768px",
      "$description": "max-width 768: single column, mobile nav",
      "query": "(max-width: 768px)"
    },
    "legal": {
      "$type": "dimension",
      "$value": "720px",
      "measuredFrom": "src/styles/Legal.css:79",
      "evidenceQuote": "720px",
      "$description": "legal page single column",
      "query": "(max-width: 720px)"
    },
    "blog": {
      "$type": "dimension",
      "$value": "640px",
      "measuredFrom": "src/styles/Blog.css:72",
      "evidenceQuote": "640px",
      "$description": "blog rows stack",
      "query": "(max-width: 640px)"
    },
    "waitlist-sm": {
      "$type": "dimension",
      "$value": "480px",
      "measuredFrom": "src/styles/Waitlist.css:515",
      "evidenceQuote": "480px",
      "$description": "waitlist heading/stat/share stack",
      "query": "(max-width: 480px)"
    },
    "post-image-sm": {
      "$type": "dimension",
      "$value": "400px",
      "measuredFrom": "src/styles/BlogPost.css:196",
      "evidenceQuote": "400px",
      "$description": "diagram placeholder 4:3",
      "query": "(max-width: 400px)"
    }
  }
}
