                },
                "required": [
                  "kind",
                  "items"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "blockquote"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxWords": 47,
                    "evidence": {
                      "longestObserved": "A quick note before we start. This is the second post in a series about how Rig runs entirely on your own hardware. If you have not read [the first one](/blog/manifesto), it explains why we care about that at all and what we are trying to build.",
                      "citation": "src/blog.js:156"
