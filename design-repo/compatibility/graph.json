  "rules": [
    {
      "id": "TEMPLATE_NODE_SEQUENCE",
      "severity": "error",
      "description": "A PageSpec's nodes must follow its DECLARED template's node list in order (variant-aware): required nodes present (minCount), non-repeatable nodes not repeated (maxCount), nothing outside the template.",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
        "templates/templates.json"
      ]
    },
    {
      "id": "TEMPLATE_VARIANT",
      "severity": "error",
      "description": "A node's variant must be one the template node allows (e.g. shell.header 'default-no-cta' only on tpl.waitlist; divider 'spacer-top' only first).",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
        "templates/templates.json"
      ]
    },
    {
      "id": "ROUTE_TEMPLATE",
      "severity": "error",
      "description": "The PageSpec route must match one of the declared template's routePatterns (':slug' = [a-z0-9-]+).",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
        "src/App.jsx:10-18"
      ]
    },
    {
      "id": "ONE_PER_PAGE",
      "severity": "error",
      "description": "Sections whose contract sets onePerPage appear once per (section, variant). layout.section-divider is the only repeatable section (onePerPage false).",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
        "src/pages/Home.jsx:33"
      ]
    },
    {
      "id": "SHELL_ORDER",
      "severity": "error",
      "description": "shell.overlays is the first node and shell.footer the last node on every template.",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
        "src/pages/Home.jsx:24",
        "src/pages/Blog.jsx:14"
      ]
    },
    {
      "id": "ONE_HERO",
      "severity": "error",
      "description": "At most one hero-category section per page; tpl.home requires one. Named exceptions: the four secondary templates have NO hero at all (spec P0.1 'No page has a hero band'), so a hero there is an error.",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
        "CLONE_SPEC.md:785"
      ],
      "parameters": {
        "heroRequiredTemplates": [
          "tpl.home"
        ],
        "noHeroTemplates": [
          "tpl.blog-index",
          "tpl.blog-post",
          "tpl.waitlist",
          "tpl.legal"
        ]
      },
      "exceptions": [
        {
          "templates": [
            "tpl.blog-index",
            "tpl.blog-post",
            "tpl.waitlist",
            "tpl.legal"
          ],
          "reason": "hero-less secondary pages (blog index, blog post incl. not-found, waitlist, legal)"
        }
      ]
    },
    {
      "id": "HOME_ROUTE_ONLY",
      "severity": "error",
      "description": "Sections that exist only in tpl.home (hero, frame lines, dividers, the ten main sections, CTA band) may only appear on route '/'.",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
        "CLONE_SPEC.md:784"
      ],
      "parameters": {
        "sections": [
          "capabilities.card-grid",
          "cta.vortex",
          "early-access.waitlist",
          "faq.accordion",
          "feature.three-col",
          "hero.home",
          "how.stepper",
          "intro.shader-diagram",
          "layout.section-divider",
          "offline.globe-split",
          "problem.signal-grid",
          "shell.frame-lines",
          "stats.strip",
          "terminal.monitor"
        ]
      }
    },
    {
      "id": "HEADER_PLACEMENT",
      "severity": "error",
      "description": "tpl.home has NO standalone shell.header (its header is embedded inside hero.home, spec §2); every other template has shell.header directly after shell.overlays (static, not sticky).",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
        "src/components/Hero.jsx:17",
        "CLONE_SPEC.md:789"
      ],
      "parameters": {
        "embeddedHeaderTemplates": [
          "tpl.home"
        ],
        "standaloneHeaderTemplates": [
          "tpl.blog-index",
          "tpl.blog-post",
          "tpl.waitlist",
          "tpl.legal"
        ]
      }
    },
    {
      "id": "NAV_VARIANT_BY_ROUTE",
      "severity": "error",
      "description": "shell.header variant is 'default-no-cta' on /waitlist (CTA <li> omitted, 74px nav) and 'default' elsewhere; content.cta must be present exactly when the variant renders a CTA.",
      "enforcedBy": "semantic_validate.py",
      "evidence": [
        "src/pages/Waitlist.jsx:110",
        "CLONE_SPEC.md:796"
      ],
      "parameters": {
        "routeVariants": {
          "/waitlist": "default-no-cta"
        },
        "defaultVariant": "default"
      }
    },
    {
      "id": "SECTION_DIVIDER_RHYTHM",
      "severity": "error",
